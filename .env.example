# ============================================================
# Job Fit Analyzer - AI provider configuration
# Copy this file to `.env.local` and fill in your own values.
# ============================================================

# Which wire format the endpoint speaks:
#   anthropic-messages  -> POST {AI_BASE_URL}/v1/messages
#   openai-completions  -> POST {AI_BASE_URL}/chat/completions
AI_API=anthropic-messages

# Base URL of the API (no trailing slash; include /v1 only if the provider needs it)
AI_BASE_URL=http://100.64.16.28:4000

# Model id. Leaving this empty makes the proxy choose its own default, which is
# currently a shared free tier that is rate-limited hard - set an explicit model.
# List what the endpoint offers with:
#   curl -s $AI_BASE_URL/v1/models -H "x-api-key: $AI_API_KEY"
AI_MODEL=claude-opus-5

# Max output tokens per request.
# IMPORTANT: reasoning models spend a big chunk of this budget on internal
# thinking before writing a single visible character. Set it too low and you get
# a 200 response with an empty body. 32000 leaves comfortable headroom.
AI_MAX_TOKENS=32000

# API key (proxies usually accept any non-empty placeholder)
AI_API_KEY=anything

# ------------------------------------------------------------
# Example: remote OpenAI-compatible endpoint
# ------------------------------------------------------------
# AI_API=openai-completions
# AI_BASE_URL=https://openagentic.id/api/v1
# AI_MODEL=deepseek-v4.1-flash
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
